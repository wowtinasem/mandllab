# ── AI ──────────────────────────────────────────────
# 비워 두면 "데모 모드": 예시 앱이 나오고 비용이 들지 않는다.
# 반드시 결제 계정이 연결된 유료 등급 키를 쓴다 (무료 등급은 입력이 Google 제품 개선에 쓰임).
GEMINI_API_KEY=

# 모델 ID는 Google AI Studio 의 모델 목록에서 확인해 맞춘다.
GEMINI_MODEL_GEN=gemini-3.8-flash          # 첫 생성·일반 수정
GEMINI_MODEL_LITE=gemini-3.1-flash-lite    # 오류 고치기·코드 설명·짧은 수정
GEMINI_THINKING_LEVEL=low                  # 생각 토큰도 출력 단가로 과금되므로 낮게. 지원하지 않는 모델이면 빈 값으로

# 100만 토큰당 "입력,출력" 달러. 사용량 보고서와 비용 상한 계산에 쓴다.
# Gemini 3.8 Flash 는 2027-01-01부터 1.50,7.50 으로 오른다.
GEMINI_PRICE_GEN=0.75,3.75
GEMINI_PRICE_LITE=0.25,1.50
KRW_PER_USD=1400

# 서버 전체 동시 AI 호출 수. 넘치면 대기열에서 순서대로 처리한다.
AI_MAX_CONCURRENT=8

# ── 운영 ────────────────────────────────────────────
# 관리자 테스트 로그인: 아이디 admin, 비밀번호는 이 값. 비우면 계정을 만들지 않는다.
ADMIN_TEST_PASSWORD=

# 설정하면 강사 가입 시 이 키를 입력해야 한다 (아무나 강사 가입 못 하게).
INSTRUCTOR_INVITE_KEY=

# DB: 비워 두면 로컬 파일(data/mandllab.db). Vercel 배포에서는 Turso 연결이 필수 (Vercel Turso 연동이 자동 설정)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 로컬 파일 위치를 바꾸려면
# DATABASE_PATH=/var/lib/mandllab/mandllab.db
